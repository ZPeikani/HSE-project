APP_NAME="سامانه مدیریت HSE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_TIMEZONE=Asia/Tehran
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hse_manager
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
OPENROUTER_API_KEY=your_openrouter_api_key_here
# اختیاری: مدل مشخص (پیش‌فرض متن: openrouter/free). برای تصویر باید مدل vision باشد.
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_VISION_MODEL=openrouter/free
# OPENROUTER_VISION_FALLBACKS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# سرویس AI سازگار با OpenAI که از ایران در دسترس است (مثال: AvalAI). نام مدل را از فهرست مدل‌های همان سرویس بردارید؛ برای تصویر باید مدل Vision باشد.
AI_BASE_URL=https://api.avalai.ir/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
# AI_PROVIDERS=compatible,openrouter
# صرفه‌جویی در اعتبار: متن اول از OpenRouter رایگان، تصویر از سرویس داخلی
# AI_PROVIDERS_TEXT=openrouter,compatible
# AI_PROVIDERS_IMAGE=compatible
# OPENROUTER_TITLE=HSE Manager
